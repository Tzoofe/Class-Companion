# Local MongoDB (brew services start mongodb/brew/mongodb-community).
# For a cloud database (e.g. MongoDB Atlas) paste its connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/class-companion
# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me
PORT=3000

# Web Push (iOS/Android notifications). Generate a pair with: npx web-push generate-vapid-keys
# Keep the same pair when moving servers, or every device has to subscribe again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# Time zone for times in exported spreadsheets (default Asia/Jerusalem).
# TIME_ZONE=Asia/Jerusalem
